<Project>
  <PropertyGroup>
    <Product>Arno's Pet Tracker</Product>
    <Authors>arnosantgaming-jpg</Authors>
    <Version>1.0.2</Version>
    <Deterministic>true</Deterministic>
    <DebugType>none</DebugType>
    <NuGetAudit>true</NuGetAudit>
    <!-- Identical source gives identical binaries, so reinstalls can keep the capture
         program (and its permission) when it has not changed. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
</Project>
